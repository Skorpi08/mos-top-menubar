#!/bin/bash
set -eu

FRONTEND_DIR="${MOS_FRONTEND_DIR:-/usr/share/mos/frontend/dist}"
INDEX_HTML="$FRONTEND_DIR/index.html"
BACKUP_HTML="$INDEX_HTML.bak"

if [ ! -f "$INDEX_HTML" ]; then
    echo "Fehler: MOS Frontend-Datei nicht gefunden: $INDEX_HTML" >&2
    exit 1
fi

CSS_OVERRIDE="<style id='mos-topbar-style'>
nav, .v-navigation-drawer, .sidebar, [role="navigation"] {
    display: flex !important;
    flex-direction: row !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: none !important;
    height: 56px !important;
    max-height: 56px !important;
    transform: translateX(0) !important;
    box-sizing: border-box !important;
    z-index: 999 !important;
}
nav ul, nav [role="list"], .sidebar ul, .sidebar [role="list"],
.v-navigation-drawer__content, .v-navigation-drawer .v-list {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
}
nav ul, .sidebar ul, .v-navigation-drawer .v-list {
    width: max-content !important;
    min-width: 100% !important;
    height: 56px !important;
    padding: 0 8px !important;
}
nav li, nav [role="listitem"], .sidebar li, .sidebar [role="listitem"],
.v-navigation-drawer .v-list-item {
    flex: 0 0 auto !important;
    min-height: 56px !important;
    white-space: nowrap !important;
}
nav a, .sidebar a, .v-navigation-drawer .v-list-item {
    display: inline-flex !important;
    align-items: center !important;
}
.v-navigation-drawer__scrim {
    display: none !important;
}
main, .v-main, .main-content {
    padding-top: 72px !important;
    padding-left: 15px !important;
}
</style>"

if [ ! -f "$BACKUP_HTML" ]; then
    cp "$INDEX_HTML" "$BACKUP_HTML"
fi

TEMP_HTML=$(mktemp "$FRONTEND_DIR/index.html.XXXXXX")
trap 'rm -f "$TEMP_HTML"' EXIT

if ! awk -v css="$CSS_OVERRIDE" '
    {
        lower = tolower($0)
        position = index(lower, "</head>")
        if (!inserted && position > 0) {
            printf "%s%s%s\n", substr($0, 1, position - 1), css, substr($0, position)
            inserted = 1
        } else {
            print
        }
    }
    END {
        if (!inserted) exit 1
    }
' "$BACKUP_HTML" > "$TEMP_HTML"; then
    echo "Fehler: Kein </head>-Tag in $INDEX_HTML gefunden." >&2
    exit 1
fi

chmod 644 "$TEMP_HTML"
mv "$TEMP_HTML" "$INDEX_HTML"
echo "Installation erfolgreich abgeschlossen."
